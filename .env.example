OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=glm
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-max
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=qwen3.8-max
GLM_ENABLE_THINKING=true
GLM_INCLUDE_REASONING=false
DASHSCOPE_ENABLE_THINKING=true
DASHSCOPE_INCLUDE_REASONING=false
LLM_TIMEOUT_SECONDS=15
EMBEDDING_MODEL=text-embedding-3-small
DISABLE_LLM=false
APP_ENV=dev
RAG_TOP_K=5
CHAT_STRICT_SCOPE=true
CHAT_RAG_QUESTION_K=3
CHAT_RAG_KNOWLEDGE_K=4
AGENT_MAX_ITERATIONS=12
AGENT_TRACE_ENABLED=true
AGENT_LLM_PLANNER_ENABLED=true
RAG_ENABLE_EMBEDDINGS=false
RAG_EMBEDDING_INDEX_DIR=data/embeddings
DATA_DIR=data
SKILL_DIR=skills

# ===== PostgreSQL =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kaoyan_ai
DB_USER=postgres
DB_PASSWORD=postgres
