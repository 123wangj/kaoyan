OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://llm-2sxrkhya27xgsx0c.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4-pro-0813
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=qwen3.8-max
GLM_ENABLE_THINKING=true
GLM_INCLUDE_REASONING=false
DASHSCOPE_ENABLE_THINKING=true
DASHSCOPE_INCLUDE_REASONING=false
LLM_TIMEOUT_SECONDS=15
EMBEDDING_MODEL=text-embedding-3-small
DISABLE_LLM=false
APP_ENV=dev
RAG_TOP_K=5
CHAT_STRICT_SCOPE=true
CHAT_RAG_QUESTION_K=3
CHAT_RAG_KNOWLEDGE_K=4
AGENT_MAX_ITERATIONS=12
AGENT_TRACE_ENABLED=true
AGENT_LLM_PLANNER_ENABLED=true
RAG_ENABLE_EMBEDDINGS=false
RAG_EMBEDDING_INDEX_DIR=data/embeddings
DATA_DIR=data
SKILL_DIR=skills

# ===== PostgreSQL =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kaoyan_ai
DB_USER=postgres
DB_PASSWORD=postgres
# Optional SMS delivery webhook. Receives JSON with phone/code/purpose/ttl_minutes.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# 开启手机号验证码功能（绑定/找回密码）。配好阿里云短信后设为 true。
SMS_FEATURE_ENABLED=false
SMS_CODE_TTL_MINUTES=10
SMS_CODE_COOLDOWN_SECONDS=60
# 防刷：单手机号 / 单 IP 每日验证码发送上限
SMS_DAILY_LIMIT_PER_PHONE=10
SMS_DAILY_LIMIT_PER_IP=30

# ===== 阿里云短信（配置后优先于 webhook）=====
# RAM 子账号 AccessKey，授权 AliyunDysmsFullAccess
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 已审核通过的短信签名，如：考研AI
ALIYUN_SMS_SIGN_NAME=
# 已审核通过的模板 CODE，模板内容需含 ${code} 变量，如：SMS_123456789
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
