# =============================================================
# 生产环境配置模板
# 使用方法:
#   1. 复制为 .env.production
#   2. 填入真实的 API Key
#   3. 启动前确保 .env.production 在 .gitignore 中
# =============================================================

# ---------- 运行环境 ----------
APP_ENV=production
DISABLE_LLM=false
LLM_TIMEOUT_SECONDS=60

# ---------- 数据目录(容器内固定 /app/data) ----------
DATA_DIR=data
SKILL_DIR=skills

# ---------- LLM 配置(必填,二选一) ----------
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=你的真实_Key_填这里
DASHSCOPE_BASE_URL=https://llm-2sxrkhya27xgsx0c.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4-pro-0813
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=qwen3.8-max
GLM_ENABLE_THINKING=true
GLM_INCLUDE_REASONING=false
DASHSCOPE_ENABLE_THINKING=true
DASHSCOPE_INCLUDE_REASONING=false

# OpenAI 兼容(可选,留空表示不用)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

EMBEDDING_MODEL=text-embedding-3-small

# ---------- RAG ----------
RAG_TOP_K=5
CHAT_STRICT_SCOPE=true
CHAT_RAG_QUESTION_K=3
CHAT_RAG_KNOWLEDGE_K=4
AGENT_MAX_ITERATIONS=12
AGENT_TRACE_ENABLED=true
AGENT_LLM_PLANNER_ENABLED=true
RAG_ENABLE_EMBEDDINGS=false
RAG_EMBEDDING_INDEX_DIR=data/embeddings

# ---------- Web 容器配置(被 gunicorn_conf.py 读取) ----------
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# ---------- CORS(生产建议改成具体域名) ----------
# 多个用逗号分隔,例如: https://kaoyan.example.com,https://admin.example.com
ALLOW_ORIGINS=*

# ---------- 端口映射(docker-compose 读取) ----------
HOST_PORT=8080
HTTP_PORT=80
# Password recovery SMS webhook (required for phone binding/reset)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_FEATURE_ENABLED=false
SMS_CODE_TTL_MINUTES=10
SMS_CODE_COOLDOWN_SECONDS=60
